pipeline {
    agent {
        kubernetes {
            yamlFile 'ci/pods/frontend.yaml'
            defaultContainer 'ci'
        }
    }

    environment {
        APP_NAME = 'recipy-mobile'
    }

    options {
        timeout(time: 60, unit: 'MINUTES')
        disableConcurrentBuilds()
        parallelsAlwaysFailFast()
    }

    stages {
        stage('Environment') {
            steps {
                script {
                    def isFeatureBranch =
                        env.BRANCH_NAME ==~ /^feature\/.+/

                    def isPullRequest =
                        env.CHANGE_ID?.trim()

                    if (isFeatureBranch && !isPullRequest) {
                        env.CI_MODE = 'FAST'
                    } else {
                        env.CI_MODE = 'FULL'
                    }

                    env.COMMIT_SHA = sh(
                        script: 'git rev-parse --short=7 HEAD',
                        returnStdout: true
                    ).trim()

                    env.COMMIT_MESSAGE = sh(
                        script: 'git log -1 --pretty=%s',
                        returnStdout: true
                    ).trim()

                    // Include all changes since the last successful build. A
                    // first build or a missing baseline must run the component suite.
                    def baseCommit = env.GIT_PREVIOUS_SUCCESSFUL_COMMIT ?: ''
                    def changedPaths = []
                    def runAll = !(baseCommit ==~ /[0-9a-fA-F]{40,64}/)
                    if (!runAll) {
                        withEnv(["CI_BASE_COMMIT=${baseCommit}"]) {
                            runAll = sh(
                                script: 'git cat-file -e "$CI_BASE_COMMIT^{commit}"',
                                returnStatus: true
                            ) != 0
                            if (!runAll) {
                                changedPaths = sh(
                                    script: 'git diff --no-renames --name-only "$CI_BASE_COMMIT" HEAD',
                                    returnStdout: true
                                ).readLines()
                            }
                        }
                    }
                    def pipelineChanged = changedPaths.any {
                        it == 'Makefile' ||
                        it == '.gitleaks.toml' ||
                        (it.startsWith('ci/') && !(it in [
                            'ci/Jenkinsfile.backend',
                            'ci/pods/backend.yaml',
                            'ci/pvc/trivy-cache-pvc.yaml',
                            'ci/scripts/push-gitops.sh'
                        ])) ||
                        it.startsWith('policy/')
                    }
                    env.FRONTEND_CHANGED = (runAll || pipelineChanged ||
                        changedPaths.any { it.startsWith('frontend/') }).toString()
                    if (pipelineChanged) {
                        env.CI_MODE = 'FULL'
                    }

                    echo """
                    ========================================
                    Pipeline Environment
                    ========================================
                    APP_NAME         : ${env.APP_NAME}
                    BRANCH_NAME      : ${env.BRANCH_NAME}
                    CHANGE_ID        : ${env.CHANGE_ID ?: '-'}
                    CHANGE_BRANCH    : ${env.CHANGE_BRANCH ?: '-'}
                    CHANGE_TARGET    : ${env.CHANGE_TARGET ?: '-'}
                    CI_MODE          : ${env.CI_MODE}
                    FRONTEND_CHANGED : ${env.FRONTEND_CHANGED}
                    COMMIT_SHA       : ${env.COMMIT_SHA}
                    ========================================
                    """.stripIndent()
                }

                sh '''
                    git --version
                '''
            }
        }

        stage('Secrets Detection') {
            // Scan every branch/PR build, including FAST and documentation-only changes.
            steps {
                sh '''
                    mkdir -p reports

                    echo "Recent commits:"
                    git log --oneline -5

                    gitleaks git . \
                        --config=.gitleaks.toml \
                        --report-format json \
                        --report-path reports/gitleaks.json \
                        --redact \
                        --verbose
                '''
            }

            post {
                always {
                    archiveArtifacts(
                        artifacts: 'reports/gitleaks.json',
                        allowEmptyArchive: true
                    )
                }
            }
        }

        stage('Mobile Install') {
            when {
                expression { env.FRONTEND_CHANGED == 'true' }
            }

            steps {
                container('flutter') {
                    dir('frontend') {
                        sh '''
                            flutter --version
                            dart --version
                            flutter pub get
                        '''
                    }
                }
            }
        }

        stage('Mobile Quality & Security') {
            when {
                allOf {
                    expression {
                        env.CI_MODE == 'FULL'
                    }

                    expression { env.FRONTEND_CHANGED == 'true' }
                }
            }

            failFast true

            parallel {
                stage('Flutter Analyze') {
                    steps {
                        container('flutter') {
                            dir('frontend') {
                                sh 'flutter analyze'
                            }
                        }
                    }
                }

                stage('Flutter Test + Coverage') {
                    steps {
                        container('flutter') {
                            dir('frontend') {
                                sh 'flutter test --coverage'
                            }
                        }
                    }
                }

                stage('Mobile SCA - OSV Scanner') {
                    steps {
                        dir('frontend') {
                            sh '''
                                osv-scanner scan source \
                                    --recursive \
                                    .
                            '''
                        }
                    }
                }
            }
        }

        stage('Mobile - Fast') {
            when {
                allOf {
                    expression {
                        env.CI_MODE == 'FAST'
                    }

                    expression { env.FRONTEND_CHANGED == 'true' }
                }
            }

            steps {
                container('flutter') {
                    dir('frontend') {
                        sh '''
                            flutter analyze
                            flutter test
                        '''
                    }
                }
            }
        }

        stage('Mobile - Build Debug APK') {
            // main (ไม่ใช่ PR) มี Release Gate build APK release อยู่แล้ว ไม่ต้อง build debug ซ้ำ
            when {
                allOf {
                    expression { env.FRONTEND_CHANGED == 'true' }
                    not {
                        allOf {
                            branch 'main'
                            expression { !env.CHANGE_ID?.trim() }
                        }
                    }
                }
            }

            steps {
                container('flutter') {
                    dir('frontend') {
                        script {
                            def branch = env.CHANGE_BRANCH?.trim() ?: env.BRANCH_NAME?.trim()
                            def config = branch in ['main', 'prod'] ? 'prod' :
                                branch in ['develop', 'staging'] ? 'staging' : 'dev'
                            env.FLUTTER_CONFIG_FILE = "config/${config}.json"
                            echo "Building debug APK for ${branch} with ${env.FLUTTER_CONFIG_FILE}"
                            sh '''
                                set -eu
                                test -f "$FLUTTER_CONFIG_FILE"
                                flutter build apk --debug --dart-define-from-file="$FLUTTER_CONFIG_FILE"
                            '''
                        }
                    }
                }
            }

            post {
                success {
                    archiveArtifacts(
                        artifacts: 'frontend/build/app/outputs/flutter-apk/app-debug.apk',
                        fingerprint: true
                    )
                }
            }
        }

        stage('Mobile - Release Gate') {
            when {
                allOf {
                    branch 'main'
                    expression { !env.CHANGE_ID?.trim() }
                    expression { env.FRONTEND_CHANGED == 'true' }
                }
            }
            steps {
                dir('frontend') {
                    sh '''
                        python3 - <<'PY'
import json
import os
from pathlib import Path
from urllib.parse import urlparse

url = os.environ.get('MOBILE_API_BASE_URL', '').strip().rstrip('/')
parsed = urlparse(url)
if parsed.scheme != 'https' or not parsed.netloc:
    raise SystemExit('MOBILE_API_BASE_URL must be a nonempty HTTPS URL')

config = json.loads(Path('config/prod.json').read_text(encoding='utf-8'))
config['API_BASE_URL'] = url
config['ENABLE_MOCK_IAP'] = True
Path('config/ci-release.json').write_text(json.dumps(config), encoding='utf-8')
PY
                    '''
                }
                withCredentials([
                    file(credentialsId: 'taskflow-android-keystore', variable: 'ANDROID_KEYSTORE_PATH'),
                    string(credentialsId: 'taskflow-android-store-pass', variable: 'ANDROID_KEYSTORE_PASSWORD'),
                    string(credentialsId: 'taskflow-android-key-alias', variable: 'ANDROID_KEY_ALIAS'),
                    string(credentialsId: 'taskflow-android-key-pass', variable: 'ANDROID_KEY_PASSWORD')
                ]) {
                    container('flutter') {
                        dir('frontend') {
                            sh '''
                                test -s "$ANDROID_KEYSTORE_PATH"
                                test -n "$ANDROID_KEYSTORE_PASSWORD"
                                test -n "$ANDROID_KEY_ALIAS"
                                test -n "$ANDROID_KEY_PASSWORD"
                                flutter build apk --release \
                                    --dart-define-from-file=config/ci-release.json
                            '''
                        }
                    }
                }
            }
            post {
                success {
                    archiveArtifacts(
                        artifacts: 'frontend/build/app/outputs/flutter-apk/app-release.apk',
                        fingerprint: true
                    )
                }
                always {
                    sh 'rm -f frontend/config/ci-release.json'
                }
            }
        }
    }

    post {
        always {
            archiveArtifacts(
                artifacts: 'frontend/coverage/**',
                allowEmptyArchive: true
            )
        }
        cleanup {
            script {
                def target = env.CHANGE_ID?.trim() ? env.CHANGE_TARGET?.trim() : env.BRANCH_NAME?.trim()
                if (['develop', 'main'].contains(target)) {
                    try {
                        withCredentials([string(credentialsId: 'discord-webhook-url', variable: 'DISCORD_WEBHOOK_URL')]) {
                            retry(3) {
                                sh "python3 ci/scripts/discord_notify.py ${currentBuild.currentResult.toLowerCase()}"
                            }
                        }
                    } catch (Exception err) {
                        echo 'WARNING: Discord notification failed.'
                    }
                }
            }
        }
    }
}
