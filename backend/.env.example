# สภาพแวดล้อมของแอป: development | staging | production
# development = synchronize schema อัตโนมัติ; staging/production ต้องรัน migration
# ไม่ตั้ง = ดูจาก NODE_ENV (production -> production, อื่น ๆ -> development)
APP_ENV=development

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=root
DB_PASSWORD=root
DB_NAME=dev

# Auth / JWT
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=10

# ลายเซ็นลิงก์ไฟล์ของขั้นตอนที่ต้องซื้อ (ไม่ตั้ง = ใช้ค่าที่ได้จาก JWT_SECRET)
# เปลี่ยนค่า = ลิงก์ที่แจกไปแล้วใช้ไม่ได้ทันที (แอปโหลดลิงก์ใหม่เองตอนเปิดสูตร)
MEDIA_SIGNING_SECRET=

# อยู่หลัง load balancer/ingress: จำนวน proxy ข้างหน้า (เช่น 1) หรือรายการ IP ที่เชื่อ
# ให้ rate limit เห็น IP จริงของผู้ใช้ ไม่มี proxy = เว้นว่าง (ใครก็ปลอม X-Forwarded-For ได้)
TRUST_PROXY=

R2_ACCOUNT_ID=xxxx
R2_ACCESS_KEY_ID=xxxx
R2_SECRET_ACCESS_KEY=xxxx
R2_BUCKET_NAME=recipy

PSU_AI_API_KEY=sk-user-xxxx
PSU_AI_BASE_URL=https://ai.psu.blue/v1
PSU_AI_MODEL=openai/gpt-5.6-luna

# Redis (เก็บ session แชท)
REDIS_URL=redis://localhost:6379

# เข้าสู่ระบบด้วย Google: OAuth client ID ที่ยอมรับ (คั่นด้วยจุลภาค)
# ใส่ Web client ID (ที่แอป Android ใช้เป็น serverClientId) และ iOS client ID ถ้ามี
# ว่าง = ปิดการเข้าสู่ระบบด้วย Google
GOOGLE_CLIENT_IDS=

# ส่งอีเมล (รหัสรีเซ็ตรหัสผ่าน) ผ่าน SMTP
# Gmail: เปิด 2-Step Verification แล้วสร้าง App Password (16 ตัว) ใส่ใน SMTP_PASS
# SMTP_HOST ว่าง = ไม่ส่งจริง development/staging จะพิมพ์รหัสลง log ของ backend แทน
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Recipy <your-account@gmail.com>"

# Push notification ผ่าน Firebase Cloud Messaging
# Firebase Console → Project settings → Service accounts → Generate new private key
# ใส่เนื้อไฟล์ JSON ทั้งก้อน (หรือเข้ารหัส base64 เป็นบรรทัดเดียว)
# ว่าง = ไม่ส่ง push (กล่องแจ้งเตือนในแอปยังทำงานปกติ)
FIREBASE_SERVICE_ACCOUNT_JSON=
